            <div class="hud-corner tr"></div>
            <div class="hud-corner bl"></div>
            <div class="hud-corner br"></div>
        </div>

        <!-- İÇERİDEKİ DERECE DAİRESİ -->
        <div class="compass-container">
            <div class="compass-dial" id="dial">
                <div id="linesContainer"></div>

                <div class="tick tick-0">0 K</div>
                <div class="tick tick-30">30</div>
                <div class="tick tick-60">60</div>
                <div class="tick tick-90">90 D</div>
                <div class="tick tick-120">120</div>
                <div class="tick tick-150">150</div>
                <div class="tick tick-180">180 G</div>
                <div class="tick tick-210">210</div>
                <div class="tick tick-240">240</div>
                <div class="tick tick-270">270 B</div>
                <div class="tick tick-300">300</div>
                <div class="tick tick-330">330</div>
            </div>
            <div class="arrow"></div>
            <div class="kaba">🕋</div>
        </div>
    </div>

    <div class="data-box">
        <div class="data-row"><span class="label">TELEFON AÇISI:</span><span class="value" id="telAngle">0°</span></div>
        <div class="data-row"><span class="label">KIBLE AÇISI:</span><span class="value" style="color: #00ff66; text-shadow: 0 0 8px #00ff66;">119°</span></div>
    </div>
    <div class="status" id="status">KIBLEYE UZAKSINIZ</div>

    <script>
        const linesContainer = document.getElementById('linesContainer');
        for (let i = 0; i < 360; i += 5) {
            const line = document.createElement('div');
            let lineType = 'small';
            if (i % 30 === 0) {
                lineType = 'large';
            } else if (i % 10 === 0) {
                lineType = 'medium';
            }
            line.className = `line-tick ${lineType}`;
            line.style.transform = `rotate(${i}deg) translate(0, -140px)`;
            linesContainer.appendChild(line);
        }

        let rawAngle = 0;
        let smoothedAngle = 0;
        const kibleAngle = 119;
        let sesIzni = false;
        let lastSoundTime = 0;

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playRelaxingLockSound() {
            if (!sesIzni) return;
            let simdi = Date.now();
            if (simdi - lastSoundTime < 2200) return;
            lastSoundTime = simdi;

            // DOKUNSAL TİTREŞİM (Haptic Feedback)
            if (navigator.vibrate) {
                navigator.vibrate(150);
            }

            const now = audioCtx.currentTime;
            const freqs = [349.23, 523.25];
            freqs.forEach((f, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                osc.type = 'sine';
                osc.frequency.setValueAtTime(f, now);
                
                gain.gain.setValueAtTime(0, now);
                gain.gain.linearRampToValueAtTime(0.18 / (idx + 1), now + 0.08);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.2);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start(now);
                osc.stop(now + 1.25);
            });
        }

        function aktivite() {
            sesIzni = true;
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            document.getElementById('mainBtn').innerText = "SİSTEM AKTİF";
            document.getElementById('mainBtn').style.borderColor = "#00ff66";
            document.getElementById('mainBtn').style.color = "#00ff66";
            document.getElementById('mainBtn').style.boxShadow = "0 0 20px rgba(0,255,102,0.3)";

            if (window.DeviceOrientationEvent) {
                if (typeof DeviceOrientationEvent.requestPermission === 'function') {
                    DeviceOrientationEvent.requestPermission()
                        .then(permissionState => {
                            if (permissionState === 'granted') {
                                window.addEventListener('deviceorientation', handleOrientation, true);
                            }
                        })
                        .catch(console.error);
                } else {
                    window.addEventListener('deviceorientation', handleOrientation, true);
                }
            }
            requestAnimationFrame(animateCompass);
        }

        function handleOrientation(event) {
            if(event.alpha !== null) {
                rawAngle = Math.round(event.webkitCompassHeading ? event.webkitCompassHeading : 360 - event.alpha);
            }
        }

        // AKICI VE YUMUŞATILMIŞ DÖNÜŞ (Low-pass Filter Animation Loop)
        function animateCompass() {
            let diff = rawAngle - smoothedAngle;
            if (diff > 180) diff -= 360;
            if (diff < -180) diff += 360;

            smoothedAngle += diff * 0.15; // 0.15 katsayısı kaymak gibi yumuşatır
            if (smoothedAngle < 0) smoothedAngle += 360;
            if (smoothedAngle >= 360) smoothedAngle -= 360;

            guncelle(smoothedAngle);
            requestAnimationFrame(animateCompass);
        }

        function guncelle(angle) {
            let displayAngle = Math.round(angle);
            document.getElementById('telAngle').innerText = displayAngle + '°';
            document.getElementById('dial').style.transform = `rotate(${-angle}deg)`;

            let diff = (kibleAngle - angle + 360) % 360;
            let kontrolDiff = diff;
            if (kontrolDiff > 180) kontrolDiff = 360 - kontrolDiff;

            const statusEl = document.getElementById('status');
            const cardEl = document.getElementById('mainCard');

            if (kontrolDiff <= 5) {
                statusEl.innerText = "KIBLE HİZALANDI!";
                statusEl.classList.add('aligned');
                cardEl.classList.add('aligned');
                playRelaxingLockSound();
            } else {
                statusEl.innerText = "KIBLEYE UZAKSINIZ";
                statusEl.classList.remove('aligned');
                cardEl.classList.remove('aligned');
            }
        }
    </script>
</body>
</html>
"""

html_bytes = HTML_CONTENT.encode('utf-8')

class SimpleHTTPRequestHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(html_bytes)))
        self.end_headers()
        self.wfile.write(html_bytes)

if __name__ == "__main__":
    socketserver.TCPServer.allow_reuse_address = True
    try:
        with socketserver.TCPServer(("", PORT), SimpleHTTPRequestHandler) as httpd:
            print(f"Sunucu aktif: http://localhost:{PORT}")
            httpd.serve_forever()
    except OSError:
        PORT = 8080
        with socketserver.TCPServer(("", PORT), SimpleHTTPRequestHandler) as httpd:
            print(f"8000 meşguldü, sunucu 8080'de açıldı: http://localhost:{PORT}")
            httpd.serve_forever()
